[Unit]
Description=Budget Automation Daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/opt/budget/budget daemon
Restart=always
RestartSec=10
User=budget
Group=budget
WorkingDirectory=/opt/budget
EnvironmentFile=/opt/budget/.env

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/budget
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
